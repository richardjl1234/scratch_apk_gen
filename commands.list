# 常用命令快速参考

# ========== m4.sh / m5.sh: 均匀缩放（两者行为一致，二选一调用） ==========
# 用默认 2.0x 缩放修改 Scratch APK
./m4.sh
./m5.sh

# 指定缩放比例（范围 0~100；>1.0 放大，<1.0 缩小）
./m4.sh 1.0
./m4.sh 2.0
./m4.sh 2.5
./m4.sh 3.0
./m4.sh 4.0
./m4.sh 5.0

./m5.sh 1.0
./m5.sh 1.5
./m5.sh 2.0
./m5.sh 2.5
./m5.sh 3.0

# ========== 验证 / 排错 ==========
# 查看 apktool / JDK 工具版本
apktool --version
keytool -help
jarsigner -help

# 安装缺失依赖（Ubuntu/Debian）
sudo apt install apktool
sudo apt install zipalign

# 验证已签名的 APK
jarsigner -verify Scratch_3.0.61_modified_2.0x.apk

# 解包输出，验证 smali 常量已替换为目标值（4 处加载 SCALE_HEX，5 次 setInitialScale 调用）
apktool d Scratch_3.0.61_modified_3.0x.apk -o /tmp/check -f
grep -nE "const(/16)? [vp][0-9]+, 0x12c$" /tmp/check/smali*/Editor.smali
grep -c "WebView;->setInitialScale(I)V" /tmp/check/smali*/Editor.smali

# 验证 viewport 钳制已解除
unzip -p Scratch_3.0.61_modified_3.0x.apk assets/www/index.html | grep "viewport"

# 安装到已连接的安卓设备
adb install -r Scratch_3.0.61_modified_3.0x.apk

# ========== 清理旧 m5.sh 字体专缩产物（如有） ==========
rm -f Scratch_3.0.61_font_*.apk