# 常用命令快速参考

# ========== apk_gen: 缩放 + 积木吸附音效 (默认 2.0x) ==========
./apk_gen/apk_gen.sh
./apk_gen/apk_gen.sh 1.0
./apk_gen/apk_gen.sh 1.5
./apk_gen/apk_gen.sh 2.0
./apk_gen/apk_gen.sh 2.5
./apk_gen/apk_gen.sh 3.0
./apk_gen/apk_gen.sh 4.0
./apk_gen/apk_gen.sh 5.0

# ========== anti-sb3: 把 .sb3 项目拆成可读 JSON ==========
python3 anti-sb3/sb3_parse.py class/L1-疯狂的小黄猫.sb3
# 输出: anti-sb3/sb3_out/project_raw.json + project_pretty.json

# ========== 验证 / 排错 ==========
apktool --version
keytool -help
jarsigner -help
perl -v

# 缺失时安装 (Ubuntu/Debian)
sudo apt install apktool
sudo apt install zipalign

# 验证已签名 APK
jarsigner -verify apk_gen/out/Scratch_3.0.61_modified_2.0x_v3.apk

# 解包验证: smali 常量 (应为 4 处 SCALE_HEX, 5 次 setInitialScale 调用)
apktool d apk_gen/out/Scratch_3.0.61_modified_3.0x_v3.apk -o /tmp/check -f
grep -nE "const [vp][0-9]+, 0x12c$" /tmp/check/smali*/Editor.smali
grep -c "WebView;->setInitialScale(I)V" /tmp/check/smali*/Editor.smali

# 解包验证: viewport 钳制已解除
grep "viewport" /tmp/check/assets/www/index.html

# 解包验证: 积木吸附音效修补成功 (应仅 1 处 NEW, 0 处 OLD)
grep -oF 'Blockly.BlockAnimations.connectionUiEffect=function(a){a.workspace.getAudioManager().play("click")};' /tmp/check/assets/www/main.js
grep -oF 'new Audio("static/blocks-media/click.wav")' /tmp/check/assets/www/main.js

# 安装到已连接的安卓设备
adb install -r apk_gen/out/Scratch_3.0.61_modified_2.0x_v3.apk

# ========== 清理旧版产物 (如残留 v2 APK) ==========
rm -f apk_gen/out/Scratch_3.0.61_modified_*x_v2.apk
rm -f Scratch_3.0.61_font_*.apk